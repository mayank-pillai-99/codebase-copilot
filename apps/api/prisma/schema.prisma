// Application schema. Models are added milestone by milestone (see docs/SPEC.md §11).
// Columns of type vector/tsvector use Unsupported(...) and are read/written with raw SQL.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  /// Stored lowercased and trimmed; uniqueness is case-insensitive in practice.
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}
