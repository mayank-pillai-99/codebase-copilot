# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/codebase_copilot

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me

# GitHub (server-side only; raises API rate limits for fetching public repos)
GITHUB_TOKEN=

# LLM
LLM_PROVIDER=ollama
LLM_MODEL=
LLM_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Embeddings (dimension is fixed in the schema; see docs/decisions)
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

# Worker
RUN_WORKER_IN_PROCESS=false

# Indexing limits
MAX_TARBALL_MB=50
MAX_SOURCE_FILES=2000
MAX_FILE_KB=200

# Frontend
API_URL=http://localhost:4000
