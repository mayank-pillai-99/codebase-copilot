# Copy to .env at the repo root: cp .env.example .env

# --- API ---
PORT=4000
LOG_LEVEL=info
# Browser origin allowed by CORS (the Next.js app)
WEB_ORIGIN=http://localhost:3000

# Database (docker compose defaults)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/codebase_copilot

# Redis (docker compose default; hosted providers use rediss://)
REDIS_URL=redis://localhost:6379

# Signs session tokens. At least 32 characters; generate with: openssl rand -base64 48
JWT_SECRET=
# Proxies in front of the API that append to X-Forwarded-For: a hop count (3 on Render), or false locally.
# Use a count rather than true: with true, the left-most entry is used, which any client can set.
TRUST_PROXY=false
# Shared by the web server and the API (same value in both). The web server forwards each visitor's IP
# signed with it, so per-visitor rate limits work through the Next.js proxy. Empty = not forwarded.
# Generate with: openssl rand -base64 48
PROXY_SECRET=

# GitHub token (server-side only). Optional: raises GitHub's API limit from 60 to 5,000 requests/hour.
# A fine-grained token with no extra permissions is enough for public repositories.
GITHUB_TOKEN=
# Run the indexing worker inside the API process (for free hosting with no separate worker).
# Locally, `npm run dev` starts a separate worker.
RUN_WORKER_IN_PROCESS=false
# Indexing limits
MAX_ARCHIVE_MB=50
MAX_SOURCE_FILES=2000
MAX_FILE_KB=200
MAX_TOTAL_SOURCE_MB=30
MAX_CHUNKS=8000

# --- Web ---
# Where Next.js rewrites /api/* to (server-side only)
API_URL=http://localhost:4000

# --- AI (Google AI Studio, free tier, no credit card: https://aistudio.google.com) ---
# Used for embeddings and chat. Leave empty to run without AI features.
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-2
LLM_MODEL=gemini-flash-latest
# Tried in order when the main model is overloaded or rate-limited
LLM_FALLBACK_MODELS=gemini-flash-lite-latest
# Chat answers per user per day
CHAT_DAILY_LIMIT=100
# New commits each user may index per day (protects the free database's storage)
INDEX_DAILY_LIMIT=10

# --- Public demo ---
# Comma-separated owner/name repositories anyone can explore without an account.
# Indexed automatically when the API starts.
DEMO_REPOSITORIES=
# Anonymous demo answers per IP per day
DEMO_CHAT_DAILY_LIMIT=20

# Committed evaluation results (eval/results/*.json), loaded into the database at startup.
# Relative to apps/api. The default suits local runs and the Docker image.
# EVAL_RESULTS_DIR=../../eval/results
