# Copy to .env at the repo root: cp .env.example .env

# --- API ---
PORT=4000
LOG_LEVEL=info
# Browser origin allowed by CORS (the Next.js app)
WEB_ORIGIN=http://localhost:3000

# Database (docker compose defaults)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/codebase_copilot

# Redis (docker compose default; hosted providers use rediss://)
REDIS_URL=redis://localhost:6379

# Signs session tokens. At least 32 characters; generate with: openssl rand -base64 48
JWT_SECRET=
# true when behind a proxy that sets X-Forwarded-For (e.g. Render); keeps rate limits per real client IP
TRUST_PROXY=false

# --- Web ---
# Where Next.js rewrites /api/* to (server-side only)
API_URL=http://localhost:4000

# --- Added in later milestones (not read yet) ---
# GITHUB_TOKEN=               # M3: server-side only; raises GitHub API rate limits
# LLM_PROVIDER=ollama         # M4
# LLM_MODEL=
# LLM_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434
# EMBEDDING_PROVIDER=ollama   # M4: dimension is fixed in the schema (see docs/decisions)
# EMBEDDING_MODEL=
# EMBEDDING_API_KEY=
